# Copy to .env. Local-only demo values; never commit .env.
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=change-me-s3
S3_REGION=us-east-1
S3_BUCKET=lakehouse
POLARIS_REALM=POLARIS
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=change-me-polaris
POSTGRES_PASSWORD=change-me-postgres
# MCP server keys (Authorization: Bearer <key>). analyst: read and propose (the agent). admin: also apply_fix and approvals.
MCP_ANALYST_KEY=change-me-analyst-key
MCP_ADMIN_KEY=change-me-admin-key
# Salt of the user_id hash the analyst sees instead of the real id. Blank: random on each start.
MASKING_SALT=change-me-masking-salt
# The agent: Gemini by default (AGENT_PROVIDER=google-genai). For Claude: AGENT_PROVIDER=anthropic, its key and AGENT_MODEL.
# Without AGENT_MODEL (or left empty) Gemini uses gemini-2.5-flash.
# AGENT_MODEL_TIMEOUT=300s   # longest a question may take; 0s = no limit; exit code 6 when passed
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Any OpenAI-compatible service: AGENT_PROVIDER=openai plus these three (AGENT_MODEL is required).
# AGENT_BASE_URL goes up to the version path and without /chat/completions, which the client adds.
# Recipes (not tried against the real services):
#   GitHub Models: AGENT_BASE_URL=https://models.github.ai/inference  AGENT_API_KEY=<GitHub token with models:read>  AGENT_MODEL=openai/gpt-4.1-mini
#   Groq:          AGENT_BASE_URL=https://api.groq.com/openai/v1      AGENT_API_KEY=<Groq key>                      AGENT_MODEL=llama-3.3-70b-versatile
#   OpenRouter:    AGENT_BASE_URL=https://openrouter.ai/api/v1        AGENT_API_KEY=<OpenRouter key>                AGENT_MODEL=<vendor/model>
#   Ollama (host): AGENT_BASE_URL=http://host.docker.internal:11434/v1 AGENT_API_KEY=ollama                         AGENT_MODEL=<a model with tool support>
# AGENT_PROVIDER=openai
# AGENT_BASE_URL=
AGENT_API_KEY=
